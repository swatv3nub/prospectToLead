# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Clay API
CLAY_API_KEY=your_clay_api_key_here

# Apollo API
APOLLO_API_KEY=your_apollo_api_key_here

# Clearbit API
CLEARBIT_API_KEY=your_clearbit_api_key_here

# PeopleDataLabs API (alternative enrichment)
PEOPLEDATALABS_API_KEY=your_pdl_api_key_here

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_email@company.com

# Google Sheets for Feedback Loop
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Vector Store (Chroma)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/workflow.log

# Workflow Configuration
WORKFLOW_CONFIG_PATH=./workflow.json
